# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Database (optional - will use SQLite by default)
DATABASE_URL=sqlite:///./classroomai.db

# Server Port
PORT=8001

# Shared with the LMS. It signs each sign-in link as
#   hash_hmac('sha256', email + '|' + ts, secret)
# and this server rebuilds the same signature to check it. Both sides must
# hold exactly the same string. Without it, LMS sign-in is refused.
LMS_SHARED_SECRET=

# How many seconds a signed link stays good for.
LMS_LINK_MAX_AGE=120
