# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Database (optional - will use SQLite by default)
DATABASE_URL=sqlite:///./classroomai.db

# Server Port
PORT=8001

# Shared with the LMS. It signs each sign-in link as
#   hash_hmac('sha256', email + '|' + ts, secret)
# and this server rebuilds the same signature to check it. Both sides must
# hold exactly the same string. Without it, LMS sign-in is refused.
LMS_SHARED_SECRET=

# How many seconds a signed link stays good for.
LMS_LINK_MAX_AGE=120

# Shared with the Moodle plugin, which sends one encrypted token:
#   /login?token=<base64url>
# Decoded that is IV(12) | GCM tag(16) | ciphertext, AES-256-GCM with no AAD,
# keyed on the raw SHA-256 of this secret. Inside is {"email":..,"ts":..}.
# Both sides must hold the same string; empty means token sign-in is refused.
LMS_TOKEN_SECRET=

# How many seconds a token stays good for. The plugin's own rule is 600.
LMS_TOKEN_MAX_AGE=600
