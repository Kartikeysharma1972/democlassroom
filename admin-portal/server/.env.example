# Server port
PORT=5002

# Path to Classroom AI's SQLite database (relative to server/). This is the
# only data the portal reads - there is no other database.
CLASSROOM_DB_PATH=../../classroom-ai/backend/classroomai.db

# Where admin accounts are kept (relative to server/)
ADMIN_DB_PATH=admin.db

# Where Classroom AI is reachable, for the teacher sign-in forwarder
CLASSROOM_AI_URL=http://localhost:8001

# Secret used to sign admin auth tokens - change in production
JWT_SECRET=change_this_secret
