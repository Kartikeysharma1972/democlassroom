# Copy to .env before `docker compose up`. Compose reads it automatically.

# Classroom AI's model keys. Several Groq keys, comma separated, are rotated.
GROQ_API_KEY=gsk_xxx,gsk_yyy

# Optional paid fallback, used only once every Groq key is rate limited.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Signs admin sessions. Any long random string; changing it signs everyone out.
ADMIN_JWT_SECRET=change_this_to_something_long_and_random

# The addresses each service will answer on. These are compiled into the
# browser bundles, so changing them needs a rebuild, not a restart.
PUBLIC_CLASSROOM_URL=http://localhost:8001
PUBLIC_ADMIN_URL=http://localhost:5002
